[Unit]
Description=ISC Sharjah timetable app (AI-SHA skill backend)
After=network.target

[Service]
Type=simple
User=hsdaou
Group=hsdaou
WorkingDirectory=/home/hsdaou/school_app
EnvironmentFile=/home/hsdaou/.school_app.env
ExecStart=/usr/bin/python3 /home/hsdaou/school_app/app.py
Restart=on-failure
RestartSec=10

# Bound to 127.0.0.1 (see the env file): the robot is the only client and it runs
# on this board, so the app needs no network exposure at all. This matters more
# than usual - the data directory holds 1,879 named minors and their subject
# enrolments, on a machine that lives in a school corridor.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hsdaou/school_app/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=append:/tmp/school_app.log
StandardError=append:/tmp/school_app.log

[Install]
WantedBy=multi-user.target
