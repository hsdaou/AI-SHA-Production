[Unit]
Description=AI-SHA speech bridge (HTTP from the Jetson -> /tts_text)
After=network.target aisha-tts.service

[Service]
Type=simple
User=pi5
WorkingDirectory=/home/pi5
ExecStart=/bin/bash -lc "source /opt/ros/jazzy/setup.bash && exec python3 /home/pi5/speech_bridge.py"
Restart=always
RestartSec=3
# Domain 44, NOT the mesh domain 42. Nothing on the Jetson subscribes to these
# topics -- the boards talk over HTTP -- and parking Jazzy nodes on 42 floods the
# Jetson Humble stack with "sequence size exceeds remaining buffer".
Environment=ROS_DOMAIN_ID=44
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
