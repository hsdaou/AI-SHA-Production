# ALSA config for the AI-SHA speaker (MAX98357A on I2S, driven via the
# hifiberry-dac overlay / snd_rpi_hifiberry_dac card).
#
# The hifiberry-dac driver exposes NO hardware mixer control, so without the
# softvol plugin below the amp runs at fixed full scale with no way to turn it
# down. softvol creates a "Master" control on card 0 that amixer can set.

pcm.dmixer {
    type dmix
    ipc_key 1024
    slave {
        pcm "hw:0,0"
        rate 48000
        channels 2
        period_size 1024
        buffer_size 4096
    }
}

pcm.softvol {
    type softvol
    slave.pcm "dmixer"
    control {
        name "Master"
        card 0
    }
    min_dB -51.0
    max_dB 0.0
}

pcm.!default {
    type plug
    slave.pcm "softvol"
}

ctl.!default {
    type hw
    card 0
}
