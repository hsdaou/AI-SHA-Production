#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    customData = {
        dictionary aisha = {
            string collision_layer = "frozen_phase7i_route_critical_geometry"
            string phase = "PHASE7J"
            string visual_layer = "complete_roomplan_capture"
            string vp_interior = "assumed_locked_not_captured"
        }
    }
)
{
    def Xform "CapturedAdministration" (
        prepend references = @./phase7j_complete_captured_administration_visual.usdc@</CapturedAdministration>
    )
    {
        over "Primary"
