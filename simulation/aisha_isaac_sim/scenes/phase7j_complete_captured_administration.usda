    def Xform "PlanAuthorityFloors" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            dictionary aisha = {
                string role = "visible_plan_authority_floor_with_atrium_step_down"
            }
        }
        prepend references = @./administration.usd@</World/Architecture/Floors>
    )
    {
        rel material:binding = </World/CapturedAdministration/Materials/Floor> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }

    def Xform "AISHA" (
        prepend references = @./administration.usd@</World/AISHA>
    )
    {
    }

    def Xform "NavigationCollision" (
        customData = {
            dictionary aisha = {
                string role = "hidden_phase7i_route_critical_collision_layer"
            }
        }
    )
    {
        def Xform "Architecture" (
            prepend references = @./administration.usd@</World/Architecture>
        )
        {
            token visibility = "invisible"
        }

        def Xform "Furniture" (
            prepend references = @./administration.usd@</World/Furniture>
        )
        {
            token visibility = "invisible"
        }
    }

    def Scope "Looks" (
        prepend references = @./administration.usd@</World/Looks>
    )
    {
    }

