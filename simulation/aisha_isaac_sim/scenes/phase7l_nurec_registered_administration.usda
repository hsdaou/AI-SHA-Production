    def Scope "Lighting" (
        customData = {
            dictionary aisha = {
                string purpose = "robot_illumination_only"
            }
        }
    )
    {
        def DomeLight "Dome"
        {
            color3f inputs:color = (0.82, 0.88, 1)
            float inputs:intensity = 420
        }

        def DistantLight "RobotKey"
        {
            float inputs:angle = 4
            float inputs:intensity = 1800
            float3 xformOp:rotateXYZ = (-48, 24, 22)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }
