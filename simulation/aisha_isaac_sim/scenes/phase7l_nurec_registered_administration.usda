            "main_administration" {
                def Xform "NuRec" (
                    customData = {
                        dictionary aisha = {
                            bool collision_enabled = 0
                            string coordinate_strategy = "nurec_native_basis"
                            string role = "atrium_reception_and_captured_administration_corridors"
