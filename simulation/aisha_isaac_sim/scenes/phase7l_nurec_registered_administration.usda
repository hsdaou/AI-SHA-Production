    upAxis = "Z"
)

def Xform "World" (
    customData = {
        dictionary aisha = {
            string collision_layer = "unchanged_frozen_phase7i_route_critical_geometry"
            string phase = "PHASE7L"
            string visual_layer = "registered_nurec_gaussian_sectors"
            string vp_interior = "assumed_locked_not_captured"
        }
    }
)
