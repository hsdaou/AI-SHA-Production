#usda 1.0
(
    customLayerData = {
        bool "aisha:physicalRelease" = 0
        string "aisha:planSha256" = "4d8698f868c296442ebd6e667d4700f2e9bc7f27b4787639395a370d76779112"
        string "aisha:purpose" = "isaac_lab_parallel_sensor_training"
    }
    defaultPrim = "Course"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Course" (
    customData = {
        dictionary aisha = {
            string centralAtriumRobotAccess = "prohibited"
            double centralAtriumStepDownM = 0.2
            string doorWidthsStatus = "user_reported_administration_minimum_conservative_destination_assumption"
            string geometryStatus = "measured_site_presentation_candidate_training_proxy"
            int sourcePlanPage = 2
        }
    }
)
{
    def "Looks"
    {
        def Material "Wall"
        {
            token outputs:surface.connect = </Course/Looks/Wall/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.82, 0.84)
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }

        def Material "Accent"
        {
            token outputs:surface.connect = </Course/Looks/Accent/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.38, 0.27)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </Course/Looks/Floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.34, 0.36)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Furniture"
        {
            token outputs:surface.connect = </Course/Looks/Furniture/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.14, 0.06)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Threshold"
        {
            token outputs:surface.connect = </Course/Looks/Threshold/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.39, 0.42)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

