            double size = 1
            float3 xformOp:scale = (0.09, 0.11, 0.43)
            double3 xformOp:translate = (0.4, 0, 0.76)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Sphere "Head" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </PresentationShell/Looks/AISHAWhite>
            double radius = 0.5
            float3 xformOp:scale = (0.33, 0.4, 0.27)
            double3 xformOp:translate = (0.5, 0, 0.96)
