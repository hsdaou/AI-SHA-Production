        )
        {
            rel material:binding = </PresentationShell/Looks/AISHALed>
            double size = 1
            float3 xformOp:scale = (0.026, 0.06, 0.012)
            double3 xformOp:translate = (0.705, -0.08, 0.92)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Sphere "CameraAperture" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </PresentationShell/Looks/BrushedMetal>
