        }

        def Cylinder "LidarCollar" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.025
            rel material:binding = </PresentationShell/Looks/BrushedMetal>
            double radius = 0.075
            double3 xformOp:translate = (0.5, 0, 1.115)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "Lidar" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            double height = 0.07
            rel material:binding = </PresentationShell/Looks/AISHABlack>
            double radius = 0.055
            double3 xformOp:translate = (0.5, 0, 1.16)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "LidarWindow" (
