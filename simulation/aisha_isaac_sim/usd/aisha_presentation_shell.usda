#usda 1.0
(
    customLayerData = {
        string "aisha:collision" = "none_visual_only"
        bool "aisha:physicalRelease" = 0
    }
    defaultPrim = "PresentationShell"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PresentationShell" (
    customData = {
        dictionary aisha = {
            string collision = "none_visual_only"
            string purpose = "live_policy_visual_shell"
        }
    }
)
{
    def "Looks"
    {
        def Material "AISHAWhite"
        {
            token outputs:surface.connect = </PresentationShell/Looks/AISHAWhite/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.73, 0.74)
                float inputs:metallic = 0.08
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "AISHAGreen"
        {
            token outputs:surface.connect = </PresentationShell/Looks/AISHAGreen/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.38, 0.24)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "AISHABlack"
        {
            token outputs:surface.connect = </PresentationShell/Looks/AISHABlack/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.022, 0.025)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "BrushedMetal"
        {
            token outputs:surface.connect = </PresentationShell/Looks/BrushedMetal/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.41, 0.43)
                float inputs:metallic = 0.72
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "AISHALed"
        {
            token outputs:surface.connect = </PresentationShell/Looks/AISHALed/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.01, 0.24, 0.12)
                color3f inputs:emissiveColor = (0, 1.35, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.16
                token outputs:surface
            }
        }
    }

    def "Geometry"
    {
        def Sphere "Body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </PresentationShell/Looks/AISHAWhite>
            double radius = 0.5
            float3 xformOp:scale = (0.82, 0.59, 0.34)
            double3 xformOp:translate = (0.02, 0, 0.4)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Sphere "LowerBumper" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </PresentationShell/Looks/AISHABlack>
            double radius = 0.5
            float3 xformOp:scale = (0.88, 0.64, 0.16)
            double3 xformOp:translate = (0.03, 0, 0.27)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Tray" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </PresentationShell/Looks/AISHAGreen>
            double size = 1
            float3 xformOp:scale = (0.78, 0.57, 0.045)
            double3 xformOp:translate = (-0.03, 0, 0.565)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "TrayPad" (
