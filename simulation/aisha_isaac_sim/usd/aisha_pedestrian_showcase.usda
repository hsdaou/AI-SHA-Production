#usda 1.0
(
    customLayerData = {
        string "aisha:assetRole" = "presentation_pedestrian_proxy"
        string "aisha:claimBoundary" = "stylized proxy; not a human biomechanics model"
    }
    defaultPrim = "Pedestrian"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Pedestrian" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        dictionary aisha = {
            string collision = "0.48_m_torso_envelope"
            string purpose = "deterministic_dynamic_safety_showcase"
        }
    }
)
{
    bool physics:kinematicEnabled = 1
    double physics:mass = 70

    def Scope "Looks"
    {
        def Material "Clothing"
        {
            token outputs:surface.connect = </Pedestrian/Looks/Clothing/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.075, 0.25, 0.55)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.64
                token outputs:surface
            }
        }
        def Material "Skin"
        {
            token outputs:surface.connect = </Pedestrian/Looks/Skin/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.28, 0.17)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }
        def Material "Shoes"
        {
            token outputs:surface.connect = </Pedestrian/Looks/Shoes/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.024, 0.03)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }
    }

    def Cube "Torso" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        rel material:binding = </Pedestrian/Looks/Clothing>
        double3 xformOp:scale = (0.36, 0.48, 0.72)
        double3 xformOp:translate = (0, 0, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "Head" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.165
        rel material:binding = </Pedestrian/Looks/Skin>
        double3 xformOp:translate = (0, 0, 0.70)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "LeftArm" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.42
        double radius = 0.055
        rel material:binding = </Pedestrian/Looks/Clothing>
        double3 xformOp:translate = (0, 0.285, 0.09)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "RightArm" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.42
        double radius = 0.055
        rel material:binding = </Pedestrian/Looks/Clothing>
        double3 xformOp:translate = (0, -0.285, 0.09)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "LeftLeg" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.42
        double radius = 0.07
        rel material:binding = </Pedestrian/Looks/Clothing>
        double3 xformOp:translate = (0, 0.105, -0.48)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "RightLeg" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.42
        double radius = 0.07
        rel material:binding = </Pedestrian/Looks/Clothing>
        double3 xformOp:translate = (0, -0.105, -0.48)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "LeftShoe" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Pedestrian/Looks/Shoes>
        double size = 1
        double3 xformOp:scale = (0.23, 0.09, 0.07)
        double3 xformOp:translate = (0.07, 0.105, -0.79)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RightShoe" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Pedestrian/Looks/Shoes>
        double size = 1
        double3 xformOp:scale = (0.23, 0.09, 0.07)
        double3 xformOp:translate = (0.07, -0.105, -0.79)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
